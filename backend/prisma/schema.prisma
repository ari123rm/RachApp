generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String
  phone             String   @unique // 🟢 Agora é obrigatório
  phone_verified    Boolean  @default(false) // 🟢 Status de verificação
  verification_code String?  // 🟢 Código OTP de 6 dígitos
  email             String   @unique
  password_hash     String
  pix_key           String?
  created_at        DateTime @default(now())

  groupsOwned   Group[]       @relation("GroupOwner")
  groups        GroupMember[]
  expensesOwned Expense[]     @relation("ExpenseOwner")
  friends       Friend[]
}
model Friend {
  id          String   @id @default(uuid())
  user_id     String   // O utilizador dono deste contacto
  name        String
  phone       String?
  color       String
  is_favorite Boolean  @default(false)

  user        User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expenses    ExpenseParticipant[]
}

model Group {
  id         String   @id @default(uuid())
  name       String
  created_by String
  created_at DateTime @default(now())

  owner      User          @relation("GroupOwner", fields: [created_by], references: [id])
  members    GroupMember[]
  expenses   Expense[]
}

model GroupMember {
  group_id String
  user_id  String

  group    Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([group_id, user_id])
}

model Expense {
  id           String   @id @default(uuid())
  user_id      String   // Quem criou a despesa (o credor principal)
  group_id     String?  // 🟢 AGORA É OPCIONAL! Se for null, é um racha avulso
  title        String
  tag          String?
  total_amount Decimal  @db.Decimal(10, 2)
  expense_date DateTime @default(now())

  owner        User                 @relation("ExpenseOwner", fields: [user_id], references: [id])
  group        Group?               @relation(fields: [group_id], references: [id], onDelete: SetNull)
  participants ExpenseParticipant[]
}



model ExpenseParticipant {
  expense_id  String
  friend_id   String   
  amount_owed Decimal @db.Decimal(10, 2)
  amount_paid Decimal @default(0.00) @db.Decimal(10, 2)

  expense     Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  friend      Friend  @relation(fields: [friend_id], references: [id], onDelete: Cascade)

  @@id([expense_id, friend_id])
}