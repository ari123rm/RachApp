{
  "name": "rachapp-root",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install --prefix backend && npm install --legacy-peer-deps --prefix frontend",
    "install:frontend": "npm install --legacy-peer-deps --prefix frontend",
    "install:backend": "npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
